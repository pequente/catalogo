# Usuário administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT
JWT_TTL=8h
JWT_SECRET=dev-secret-change-me-min-32-chars-long!!

# Armazenamento: development usa data-dev/; production usa fs (data/) ou github (Vercel).
# Dados locais: npm run dev:restore:data | dev:reset:data | dev:seed
# Índices: npm run indices:rebuild | indices:repair | indices:validate
DATA_BACKEND=fs

# URL pública da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Observabilidade de leitura: ligada em development e desligada em production.
# Verificação: npm run phase6:verify [-- --strict]
# READ_METRICS=1

# Obrigatórios quando DATA_BACKEND=github
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_BRANCH=main
# GITHUB_REPO=vina
